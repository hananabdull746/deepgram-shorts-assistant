APP_HOST=127.0.0.1
APP_PORT=8090
DATA_DIR=./data
DATABASE_PATH=./data/clipcue.sqlite3
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-session-secret
COOKIE_SECURE=false
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
DEEPGRAM_TIMEOUT_SECONDS=570
# Optional: public HTTPS URL behind a reverse proxy; enables Deepgram callback mode for long jobs.
PUBLIC_BASE_URL=
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_SECONDS=10800
MAX_VIDEO_PIXELS=2073600
MAX_CLIPS_PER_PROJECT=12
